---
// Every project, as a book on a shelf.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectShelf from '../../components/ProjectShelf.astro';
import { getProjects } from '../../lib/content';
import { paletteCss } from '../../lib/hero/palette';

const projects = await getProjects();
// DEV ONLY: sample projects for the edge cases, on a shelf of their own. Imported only in dev, so
// the build holds none of it.
const samples = import.meta.env.DEV ? (await import('../../lib/project-samples')).samples : undefined;
---

<BaseLayout title="Projects" description="Things I have built.">
  <h1 class="sr-only">Projects</h1>
  <div class="projects">
    <ProjectShelf projects={projects} />
    {samples && <ProjectShelf projects={samples} id="samples" label="Dev samples" />}
  </div>
  <style is:inline set:html={paletteCss('.projects')}></style>
</BaseLayout>

<style>
  .projects {
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }
</style>

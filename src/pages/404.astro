---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeScene from '../components/HomeScene.astro';
---

<BaseLayout title="Not found" description="This page doesn't exist, or it moved.">
  <div class="lost">
    <div class="lost-text">
      <h1>Nothing grows here.</h1>
      <p>This page doesn't exist, or it moved.</p>
      <p class="lost-links"><a href="/">Back home</a> · <a href="/writing/">Writing</a></p>
    </div>
    <HomeScene />
  </div>
</BaseLayout>

<style>
  /* Like the homepage: a few lines on the left, the field on the right, the scarecrow alone in
     it. On phones the scene is hidden (HomeScene) and the text stands alone. */
  .lost {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: clamp(1rem, 4vw, 3rem);
  }

  /* Beside the scarecrow, the links about level with the horizon, above the faded edge of the
     scene. */
  .lost-text {
    position: relative;
    z-index: 1;
    margin-bottom: 2rem;
  }

  /* The page's only heading, kept quiet: a little larger than the text, not a title. */
  .lost-text h1 {
    font-size: 1.375rem;
    margin-bottom: 0.75rem;
  }

  .lost-links {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .lost {
      grid-template-columns: minmax(0, 1fr);
    }

    .lost-text {
      margin: clamp(0.5rem, 2vw, 1.5rem) 0 0;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeScene from '../components/HomeScene.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/content';
import { site } from '../site';

// Pinned posts first; the sort is stable, so each part stays newest first.
const posts = (await getPosts()).sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned));
---

<BaseLayout>
  <h1 class="sr-only">{site.name}</h1>

  <div class="home">
    <section class="home-section" aria-labelledby="writing">
      <h2 id="writing" class="label">Writing</h2>
      <PostList posts={posts} />
    </section>
    <HomeScene />
  </div>
</BaseLayout>

<style>
  /* The list on the left, the scene beside it on the right, both resting on the same line. */
  .home {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: clamp(1rem, 4vw, 3rem);
  }

  /* The list starts close under the header, above the faded edge of the scene. */
  .home-section {
    position: relative;
    z-index: 1;
    align-self: start;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }

  @media (max-width: 760px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

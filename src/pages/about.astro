---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutScene from '../components/AboutScene.astro';
import { icons } from '../lib/icons';
import { site } from '../site';

const email = site.links.find((link) => link.url.startsWith('mailto:'))?.url;
---

<BaseLayout title="About" description={site.owner ? `About ${site.owner}.` : 'About this site and its author.'}>
  <h1 class="sr-only">About</h1>

  <div class="about">
    <div class="about-text">
      <div class="bio">
        <p>
          I'm a curious engineer, happiest on roads I don't know yet. Right now that road is cybersecurity, on both
          sides of the terminal: breaking things in a lab to see how attacks work, and digging through logs and packets
          to see what they leave behind.
        </p>
        <p>
          I also build small tools when I need them in my own setup, and write down what I figure out here. I'm
          Security+ certified, and you can reach me at <a href={email}>contact@to1un.com</a>.
        </p>
      </div>

      <ul class="links" aria-label="Profiles">
        {
          site.links
            .filter((link) => !link.url.startsWith('mailto:'))
            .map((link) => (
              <li>
                <a href={link.url} rel="me">
                  <svg class="link-icon" viewBox={icons[link.icon].viewBox} aria-hidden="true" focusable="false">
                    <path d={icons[link.icon].path} />
                  </svg>
                  {link.label}
                </a>
              </li>
            ))
        }
      </ul>
    </div>
    <AboutScene />
  </div>
</BaseLayout>

<style>
  /* Like the homepage: the text on the left, the scene beside it on the right, here up close. */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    align-items: start;
    column-gap: clamp(1rem, 4vw, 3rem);
  }

  /* The text reaches into the scene's empty sky on the left (the scarecrow's arm starts ~150px in),
     for longer lines, and is painted above it. */
  .about-text {
    container: about-text / inline-size; /* the links follow its width (global.css) */
    position: relative;
    z-index: 1;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
    margin-inline-end: -9rem;
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2rem;
    }

    .about-text {
      margin-inline-end: 0;
    }
  }
</style>

---
// The sun of the scenes in a soft glow, the backlight of the field, the moon at night. By day
// its rays turn slowly (held still under reduced motion). The scene around it places and sizes
// it (.sky-body) and gives it its colours (--c-sun, --c-glow); its view-transition-name pairs it
// across pages, so the sun on the homepage grows into the one on /about.

// Sun rays: short strokes around the disc, alternating long and short.
const rays = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  const [r1, r2] = i % 2 ? [60, 68] : [60, 74];
  return {
    x1: (70 + Math.cos(a) * r1).toFixed(1),
    y1: (70 + Math.sin(a) * r1).toFixed(1),
    x2: (70 + Math.cos(a) * r2).toFixed(1),
    y2: (70 + Math.sin(a) * r2).toFixed(1),
  };
});
---

<svg class="sky-body" viewBox="0 0 140 140" aria-hidden="true">
  <defs>
    <radialGradient id="sky-glow">
      <stop offset="0" stop-opacity="0.95"></stop>
      <stop offset="0.37" stop-opacity="0.7"></stop>
      <stop offset="0.6" stop-opacity="0.25"></stop>
      <stop offset="0.8" stop-opacity="0.07"></stop>
      <stop offset="1" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <circle class="glow" cx="70" cy="70" r="130" fill="url(#sky-glow)"></circle>
  <g class="rays">
    {rays.map((r) => <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} />)}
  </g>
  <circle class="disc" cx="70" cy="70" r="48"></circle>
</svg>

<style>
  .sky-body {
    --rays: 1;
    overflow: visible;
    pointer-events: none;
    view-transition-name: scene-sun;
  }

  /* Rays only while the sky is light. */
  :global(:root[data-scheme='dark']) .sky-body {
    --rays: 0;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-scheme])) .sky-body {
      --rays: 0;
    }
  }

  .disc {
    fill: var(--c-sun);
  }

  stop {
    stop-color: var(--c-glow);
  }

  .rays {
    opacity: var(--rays);
    stroke: var(--c-sun);
    stroke-width: 5;
    stroke-linecap: round;
    transform-origin: 70px 70px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rays {
      animation: sun-turn 240s linear infinite;
    }
  }

  @keyframes sun-turn {
    to {
      transform: rotate(360deg);
    }
  }
</style>

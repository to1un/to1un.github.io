---
// The projects, compact enough for hundreds: tiles of mark, name and a two-line tagline, three per
// row (two on narrower screens, a list of one on phones); an unannounced one is its mark alone. A
// project's name links to its post; its one other link, the repo, is a small icon beside it.
import type { ProjectView } from '../lib/content';
import ProjectMark from './ProjectMark.astro';
import ProjectRepo from './ProjectRepo.astro';

interface Props {
  projects: ProjectView[];
}

const { projects } = Astro.props;

const items = projects.map((p) => ({
  ...p,
  Tag: p.href ? ('a' as const) : ('span' as const),
  state: p.status === 'active' ? undefined : p.status,
}));
---

<ul class="list">
  {
    items.map((p) => (
      <li class:list={['item', p.status]}>
        <ProjectMark project={p} size={48} />
        <p class="head">
          <p.Tag class:list={['name', { 'sr-only': p.secret }]} href={p.href}>
            {p.name}
            {p.state && <span class="sr-only">({p.state})</span>}
          </p.Tag>
          {p.repo && <ProjectRepo href={p.repo} />}
        </p>
        {p.tagline && (
          <p class="tagline" title={p.tagline}>
            {p.tagline}
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 44rem) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .list {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
    }
  }

  .item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 0.9rem;
    position: relative;
  }

  .item :global(.mark) {
    grid-row: 1 / 3;
    align-self: start;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    line-height: 1.4;
  }

  .name {
    color: inherit;
    font-weight: 600;
    text-decoration: underline transparent 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.15s ease;
  }

  a.name:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }

  /* The whole tile follows the name's link. */
  a.name::before {
    content: '';
    position: absolute;
    inset: 0;
  }

  .upcoming .name {
    color: var(--muted);
  }

  .tagline {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>

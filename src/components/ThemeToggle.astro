---
// The day/night switch in the header: a sun while the site is dark (to make it light), a moon
// while it is light. The choice is stored and applied before first paint on every page by the
// sky script (src/lib/sky.ts, window.__sky). Hidden without JS, where the system's preference
// decides.
const rays = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2;
  const p = (r: number) => `${(12 + Math.cos(a) * r).toFixed(2)} ${(12 + Math.sin(a) * r).toFixed(2)}`;
  return `M${p(7.5)}L${p(9.5)}`;
}).join('');
---

<button type="button" class="theme-toggle" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.25"></circle>
    <path d={rays}></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M19.5 14.6A7.75 7.75 0 0 1 9.4 4.5a7.75 7.75 0 1 0 10.1 10.1Z"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sky = window.__sky;
  if (button && sky) {
    const sync = () => {
      const dark = sky.scheme === 'dark';
      button.setAttribute('aria-pressed', String(dark));
      button.title = dark ? 'Switch to light theme' : 'Switch to dark theme';
    };
    button.addEventListener('click', () => sky.set(sky.scheme === 'dark' ? 'light' : 'dark'));
    addEventListener('sky', sync);
    sync();
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    align-self: center;
    width: 2rem;
    height: 2rem;
    margin: -0.25rem -0.375rem -0.25rem -0.5rem;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--fg);
  }

  svg {
    grid-area: 1 / 1;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The sun while dark, the moon while light; set before first paint, so no flicker. */
  .sun {
    display: none;
  }

  :global(:root[data-scheme='dark']) .sun {
    display: block;
  }

  :global(:root[data-scheme='dark']) .moon {
    display: none;
  }

  /* Without JS there is nothing to switch. */
  :global(:root:not([data-scheme])) .theme-toggle {
    visibility: hidden;
  }
</style>

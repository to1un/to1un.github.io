---
import '../styles/global.css';
import { site, type Lang } from '../site';
import { icons } from '../lib/icons';
import { inlineSource } from '../lib/inline';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SKY, runSky, skyCss } from '../lib/sky';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  lang?: Lang; // language of the page content; the chrome is always English
  card?: string; // the link preview image, under /og/ (src/pages/og); else the site's
}

const { title, description = site.description, type = 'website', lang = 'en', card } = Astro.props;
const locales: Record<Lang, string> = { en: 'en_US', tr: 'tr_TR' };
// When the content is not English, mark the English chrome explicitly.
const chromeLang = lang === 'en' ? undefined : 'en';
// The owner's name follows page titles, and the homepage's title is the name alone (see
// src/site.ts); the header link stays site.name.
const homeTitle = site.owner ?? site.name;
const pageTitle = title ? (site.owner ? `${title} · ${site.owner}` : title) : homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rss = new URL('rss.xml', Astro.site);
// The preview card: the page's own (a post's title), else the site's (the name); either beside
// the scarecrow in its field, 1200 × 630 (src/lib/og/card.ts).
const cardUrl = new URL(card ?? '/og/site.png', Astro.site);
const cardAlt = `${card ? (title ?? homeTitle) : homeTitle}, beside a scarecrow in a field ${site.preview === 'night' ? 'by moonlight' : 'in the sun'}`;
const path = Astro.url.pathname;
// Email and GitHub also sit in the footer (site.links, same order).
const contact = site.links.filter((link) => link.icon === 'email' || link.icon === 'github');
const nav = [
  { label: 'Writing', href: '/writing/' },
  // { label: 'Projects', href: '/projects/' },
  { label: 'About', href: '/about/' },
];
// Day or night: the visitor's choice (the toggle), else their system's colour scheme, set on
// <html> before first paint. Without JS, prefers-color-scheme alone decides.
const skyScript = `(${inlineSource(runSky)})(${JSON.stringify(SKY.key)})`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <style is:inline set:html={skyCss()}></style>
    <script is:inline set:html={skyScript}></script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.owner ?? 'Writing'} href={rss} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    {site.owner && <meta property="og:site_name" content={site.owner} />}
    <meta property="og:title" content={title ?? homeTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[lang]} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? homeTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main" lang={chromeLang}>Skip to content</a>
    <header class="site-header" lang={chromeLang}>
      <a href="/" class="site-name">{site.name}</a>
      <nav aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer" lang={chromeLang}>
      <p>© {new Date().getFullYear()}{site.owner && ` ${site.owner}`} · <a href="/rss.xml">RSS</a></p>
      <ul class="footer-links" aria-label="Contact">
        {
          contact.map((link) => (
            <li>
              <a
                href={link.url}
                rel={link.icon === 'github' ? 'me' : undefined}
                aria-label={link.label}
                title={link.label}
              >
                <svg viewBox={icons[link.icon].viewBox} aria-hidden="true" focusable="false">
                  <path d={icons[link.icon].path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </footer>
  </body>
</html>
